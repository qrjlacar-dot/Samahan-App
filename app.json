{
  "expo": {
    "name": "Samahan",
    "slug": "Samahan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "samahan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.samahan.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "react-native-nitro-google-signin",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyAqILA5qgbZw_nEwasA2nFxSn6ejEkUIkc"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SAMAHAN uses your location to show where you are and to guide your commute."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "trip-updates"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f4519ea7-cbc1-405e-91d5-1c7bbef6cb46"
      }
    }
  }
}
