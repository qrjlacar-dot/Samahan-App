# Copy this file to .env.local and fill in the real values.
# Never commit .env.local. It is already listed in .gitignore.
# Get the real values from the project leader, not from GitHub.

# Geoapify (place search and routing)
EXPO_PUBLIC_GEOAPIFY_API_KEY=PASTE_YOUR_GEOAPIFY_KEY_HERE

# Google Maps (Android map display, read by app.config.js)
GOOGLE_MAPS_API_KEY=PASTE_YOUR_GOOGLE_MAPS_KEY_HERE

# Firebase web config (read by src/services/auth/firebase.js)
EXPO_PUBLIC_FIREBASE_API_KEY=PASTE_YOUR_FIREBASE_API_KEY_HERE
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=PASTE_YOUR_SENDER_ID_HERE
EXPO_PUBLIC_FIREBASE_APP_ID=PASTE_YOUR_FIREBASE_APP_ID_HERE

# Optional: path to google-services.json if it is not in the project root.
# EAS builds set this automatically from the GOOGLE_SERVICES_JSON file variable.
# GOOGLE_SERVICES_JSON=./google-services.json